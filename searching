void searchByStudentID(int studentID) {
    Reservation* current = head;
    bool found = false;

    while (current != nullptr) {
        if (current->studentID == studentID) {
            current->display();
            cout << "-----------------------------" << endl;
            found = true;
        }

        current = current->next;
    }

    if (!found) {
        cout << "No reservations found for Student ID: "
             << studentID << endl;
    }
}
